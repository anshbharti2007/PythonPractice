   "source": [
    "# 1: Contain Dublicates"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "51c320ee",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Solution:\n",
    "    def containsDuplicate(self, nums: List[int]) -> bool:\n",
    "        s = set()\n",
    "        for num in nums:\n",
    "            if num in s:\n",
    "                return True\n",
    "            else:\n",
    "                s.add(num)\n",
    "        return False"
   ]
  },
